{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js"]
}
