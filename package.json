{
  "name": "schreibwerkstatt-browser-extension",
  "version": "0.2.0",
  "description": "Chrome-Erweiterung: Webseiten als Recherche-Fundstueck oder zitierfaehige Quelle in die Schreibwerkstatt schicken.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "icons": "node tools/make-icons.mjs",
    "package": "node build.mjs && node tools/package.mjs",
    "promo": "node tools/make-promo.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1"
  }
}
